# ==========================================
# PlanSmart Content Engine - Environment V2
# ==========================================

# ------------------------------------------
# 🧠 Core AI Providers
# ------------------------------------------
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-api03-...your_key_here"

# OpenRouter (Used for fallback/specialized generation)
OPENROUTER_API_KEY="sk-or-v1-...your_key_here"

# MUAPI (Custom endpoint if applicable)
MUAPI_API_KEY="your_muapi_key_here"

# ------------------------------------------
# 🗄️ State Management (Supabase)
# ------------------------------------------
# Get these at: https://supabase.com/dashboard/project/ -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="eyJhbG...your_anon_public_key_here"
SUPABASE_SERVICE_KEY="eyJhbG...your_service_role_key_here"

# ------------------------------------------
# 🤖 Human-in-the-Loop (Telegram)
# ------------------------------------------
# Talk to @BotFather on Telegram to create a bot and get the token
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRstuVWxyz"
# Ensure the target chat ID is explicitly defined for the approval loop
# APPROVAL_CHAT_ID="-100123456789"

# ------------------------------------------
# ⚙️ Application Configuration
# ------------------------------------------
# Safe defaults for non-secret configurations
ENVIRONMENT="development"      # Use 'production' for Railway
LOG_LEVEL="INFO"               # Options: DEBUG, INFO, WARNING, ERROR
WEBHOOK_BASE_URL="https://your-app.up.railway.app"

# ------------------------------------------
# 🛡️ Monitoring & Observability
# ------------------------------------------
# Sentry DSN for error tracking (Optional but recommended for production)
SENTRY_DSN="https://public@sentry.io/project-id"