# ═══════════════════════════════════════════
# CLAUDE / ANTHROPIC
# ═══════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-...

# ═══════════════════════════════════════════
# SUPABASE (külön project a PPC monitortól!)
# ═══════════════════════════════════════════
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=eyJhbGc...
SUPABASE_SERVICE_KEY=eyJhbGc...       # csak server-side használathoz

# ═══════════════════════════════════════════
# TELEGRAM BOT
# ═══════════════════════════════════════════
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_POSTS_CHAT_ID=-1001234567890       # csoport / channel ID a posztokhoz
TELEGRAM_REACTIONS_CHAT_ID=-1001234567891   # csoport / channel a reakciókhoz

# ═══════════════════════════════════════════
# LINKEDIN — 3 fiók
# ═══════════════════════════════════════════
# Dávid személyes
LINKEDIN_DAVID_TOKEN=...
LINKEDIN_DAVID_USER_ID=urn:li:person:...

# Ádám személyes
LINKEDIN_ADAM_TOKEN=...
LINKEDIN_ADAM_USER_ID=urn:li:person:...

# PlanSmart céges oldal
LINKEDIN_PLANSMART_TOKEN=...
LINKEDIN_PLANSMART_ORG_ID=urn:li:organization:...

# ═══════════════════════════════════════════
# TWITTER / X — 2 fiók
# ═══════════════════════════════════════════
# Dávid
TWITTER_DAVID_CONSUMER_KEY=...
TWITTER_DAVID_CONSUMER_SECRET=...
TWITTER_DAVID_TOKEN=...
TWITTER_DAVID_SECRET=...

# Ádám
TWITTER_ADAM_CONSUMER_KEY=...
TWITTER_ADAM_CONSUMER_SECRET=...
TWITTER_ADAM_TOKEN=...
TWITTER_ADAM_SECRET=...

# ═══════════════════════════════════════════
# LINKEDIN SCRAPING (Phantombuster vagy Apify)
# ═══════════════════════════════════════════
PHANTOMBUSTER_API_KEY=...
# VAGY
APIFY_TOKEN=...

# ═══════════════════════════════════════════
# RAILWAY (production env)
# ═══════════════════════════════════════════
RAILWAY_ENVIRONMENT=production         # vagy "dev"
PORT=8080
WEBHOOK_BASE_URL=https://plansmart-content.up.railway.app

# ═══════════════════════════════════════════
# OPCIONÁLIS — monitoring
# ═══════════════════════════════════════════
SENTRY_DSN=https://...

# ═══════════════════════════════════════════
# FEJLESZTÉSI BEÁLLÍTÁSOK
# ═══════════════════════════════════════════
LOG_LEVEL=INFO                          # DEBUG / INFO / WARN / ERROR
DRY_RUN=false                           # true: nem postázunk, csak generálunk
RELEVANCE_THRESHOLD=6                   # ennél kisebb score → skip
